---
import "../styles/components/sermon-card.css";

interface Props {
  title: string;
  description: string;
  url: string;
}

const { title, description, url } = Astro.props;
---

<a href={url} class="sermon-card">

  <div class="sermon-card__image"></div>

  <div class="sermon-card__content">

    <h3>{title}</h3>

    <p>{description}</p>

    <span class="sermon-card__link">
      Leer más →
    </span>

  </div>

</a>

