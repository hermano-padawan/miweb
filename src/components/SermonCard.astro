---
import "../styles/components/sermon-card.css";

interface Props {
  title: string;
  description: string;
  url: string;
}

const { title, description, url } = Astro.props;
---

<article class="sermon-card">
  <h2>{title}</h2>

  <p>{description}</p>

  <a href={url}>Leer sermón →</a>
</article>

