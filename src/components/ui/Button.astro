---

import "../../styles/components/button.css";


interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "outline";
}

const {
  href,
  variant = "primary"
} = Astro.props;
---

{
  href ? (
    <a href={href} class={`button button--${variant}`}>
      <slot />
    </a>
  ) : (
    <button class={`button button--${variant}`}>
      <slot />
    </button>
  )
}