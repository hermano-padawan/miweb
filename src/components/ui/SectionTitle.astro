---
import "../../styles/components/section-title.css";

interface Props {
  title: string;
  subtitle?: string;
  center?: boolean;
  level?: "h1" | "h2";
}

const {
  title,
  subtitle,
  center = false,
  level = "h2"
} = Astro.props;
const Heading = level;
---

<header class={`section-title ${center ? "section-title--center" : ""}`}>

  <Heading>{title}</Heading>

  {subtitle && (
    <p>{subtitle}</p>
  )}

</header>
