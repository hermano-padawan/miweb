---
import { RotateCcw, Share2 } from "lucide-astro";
const questions=[
 {q:"Cuando aparece un reto difícil, ¿qué haces primero?",a:[["Actúo con valentía","David"],["Pienso una estrategia","Ester"],["Mantengo la calma y persevero","José"]]},
 {q:"¿Qué valor te representa mejor?",a:[["Coraje","David"],["Prudencia","Ester"],["Paciencia","José"]]},
 {q:"En un grupo sueles ser quien...",a:[["Da el primer paso","Pedro"],["Protege a los demás","Ester"],["Une y reconcilia","José"]]},
 {q:"Si cometes un error, prefieres...",a:[["Reconocerlo y volver a empezar","Pedro"],["Aprender en silencio","José"],["Preparar una solución","Ester"]]},
 {q:"¿Qué escenario te atrae más?",a:[["Una misión arriesgada","David"],["Una conversación decisiva","Ester"],["Un proyecto a largo plazo","José"]]},
 {q:"Ante una injusticia...",a:[["Me enfrento a ella","David"],["Busco el momento adecuado","Ester"],["Trabajo para transformar la situación","José"]]},
 {q:"Tus amigos valoran tu...",a:[["Espontaneidad","Pedro"],["Lealtad","David"],["Serenidad","José"]]},
 {q:"¿Cómo tomas una decisión importante?",a:[["Confío y avanzo","Pedro"],["Observo y preparo el camino","Ester"],["Espero con paciencia","José"]]},
 {q:"Si un plan cambia de repente...",a:[["Improviso y sigo","Pedro"],["Reviso cada opción","Ester"],["Mantengo el propósito","José"]]},
 {q:"¿Qué te ayuda a superar el miedo?",a:[["Recordar victorias anteriores","David"],["Hablar con alguien de confianza","Pedro"],["Prepararme bien","Ester"]]},
 {q:"Cuando alguien te decepciona...",a:[["Busco reconciliarme","José"],["Digo lo que siento","Pedro"],["Tomo distancia y reflexiono","Ester"]]},
 {q:"¿Qué papel prefieres en un proyecto?",a:[["Liderar desde el frente","David"],["Coordinar los detalles","Ester"],["Sostener al equipo","José"]]},
 {q:"Ante una oportunidad inesperada...",a:[["Me lanzo","Pedro"],["Compruebo si es el momento","Ester"],["Pienso en el largo plazo","José"]]},
 {q:"¿Qué aprendizaje valoras más?",a:[["Levantarse después de caer","Pedro"],["Esperar sin perder la esperanza","José"],["Usar bien la influencia","Ester"]]},
 {q:"¿Cómo quieres que te recuerden?",a:[["Por mi valentía","David"],["Por mi fidelidad","José"],["Por ayudar cuando era necesario","Ester"]]},
];
---
<section class="personality" data-personality><header><span>Dinámica de personalidad</span><h2>¿Qué personaje bíblico eres?</h2><p data-personality-progress>Pregunta 1 de 15</p></header><article data-personality-card><h3 data-personality-question>{questions[0].q}</h3><div data-personality-answers>{questions[0].a.map(([answer])=><button type="button">{answer}</button>)}</div></article><article class="personality__result" data-personality-result hidden tabindex="-1"><span>Tu resultado</span><h3 data-personality-name></h3><p data-personality-copy></p><strong>Envíale este juego a alguien</strong><button data-personality-share type="button"><Share2 size={19}/> Compartir juego</button><button data-personality-retry type="button"><RotateCcw size={18}/> Repetir</button></article></section>
<script type="application/json" data-personality-data set:html={JSON.stringify(questions)}></script>
<script>
 const root=document.querySelector<HTMLElement>("[data-personality]");const src=document.querySelector<HTMLScriptElement>("[data-personality-data]");if(root&&src){const qs=JSON.parse(src.textContent||"[]");const descriptions:{[key:string]:string}={David:"Valentía, iniciativa y confianza para afrontar retos que parecen grandes.",Ester:"Prudencia, propósito y capacidad para actuar en el momento adecuado.",José:"Perseverancia, paciencia y disposición para reconciliar incluso en circunstancias difíciles.",Pedro:"Espontaneidad, honestidad y capacidad para levantarte después de fallar."};let current=0;let scores:{[key:string]:number}={David:0,Ester:0,José:0,Pedro:0};const card=root.querySelector<HTMLElement>("[data-personality-card]")!,result=root.querySelector<HTMLElement>("[data-personality-result]")!,buttons=[...root.querySelectorAll<HTMLButtonElement>("[data-personality-answers] button")];const set=(s:string,v:string)=>{const e=root.querySelector<HTMLElement>(s);if(e)e.textContent=v};const render=()=>{set("[data-personality-progress]",`Pregunta ${current+1} de ${qs.length}`);set("[data-personality-question]",qs[current].q);buttons.forEach((b,i)=>b.textContent=qs[current].a[i][0]);root.scrollIntoView({block:"start"})};buttons.forEach((b,index)=>b.addEventListener("click",()=>{scores[qs[current].a[index][1]]++;card.classList.add("is-leaving");setTimeout(()=>{if(current<qs.length-1){current++;render();card.classList.remove("is-leaving")}else{const name=Object.entries(scores).sort((a,b)=>b[1]-a[1])[0][0];set("[data-personality-progress]","Experiencia completada");set("[data-personality-name]",`Tu personaje es ${name}`);set("[data-personality-copy]",descriptions[name]);card.hidden=true;result.hidden=false;result.focus()}},200)}));root.querySelector("[data-personality-retry]")?.addEventListener("click",()=>{current=0;scores={David:0,Ester:0,José:0,Pedro:0};result.hidden=true;card.hidden=false;render()});root.querySelector("[data-personality-share]")?.addEventListener("click",async()=>{const name=root.querySelector("[data-personality-name]")?.textContent;const data={title:"¿Qué personaje bíblico eres?",text:`${name} en el juego de Nexo Bíblico. ¿Cuál eres tú?`,url:location.href};if(navigator.share)await navigator.share(data);else await navigator.clipboard.writeText(`${data.text} ${data.url}`)})}
</script>
<style>
 .personality{width:min(100%,760px);margin:auto;scroll-margin-top:78px}.personality header{position:relative;margin-bottom:1rem}.personality header span,.personality__result>span{color:var(--color-primary-dark);font-size:.78rem;font-weight:850;letter-spacing:.11em;text-transform:uppercase}.personality header h2{margin:.2rem 0;font-size:clamp(1.55rem,5vw,2.15rem)}.personality header p{margin:0;color:var(--color-text-light);font-weight:700}.personality article{padding:clamp(1.1rem,4vw,2rem);background:#fff;border:1px solid var(--color-border);border-radius:8px;box-shadow:var(--shadow-md);transition:.2s}.personality article.is-leaving{opacity:0;transform:translateY(8px)}.personality article h3{margin:0 0 1.3rem;font-size:clamp(1.3rem,4vw,1.75rem)}[data-personality-answers]{display:grid;gap:.7rem}[data-personality-answers] button{min-height:60px;padding:.75rem 1rem;text-align:left;color:var(--color-text);background:#fff;border:1px solid #cbd7df;border-radius:8px;font:inherit;font-weight:750;cursor:pointer}[data-personality-answers] button:hover{background:#fff8eb;border-color:var(--color-primary)}.personality__result{text-align:center}.personality__result[hidden],[data-personality-card][hidden]{display:none}.personality__result h3{margin:1rem 0 .5rem;font-size:clamp(2rem,7vw,3rem)}.personality__result p{max-width:520px;margin:0 auto 1.4rem;color:var(--color-text-light)}.personality__result button{display:inline-flex;align-items:center;gap:.45rem;min-height:48px;margin:.25rem;padding:.7rem 1rem;color:#fff;background:var(--color-primary);border:0;border-radius:8px;font:inherit;font-weight:800}.personality__result button:last-child{color:var(--color-text);background:#fff;border:1px solid #bdcad3}@media(max-width:520px){.personality__result button{width:100%;justify-content:center;margin:.3rem 0}}
</style>
