---
import "../../styles/components/footer.css";
import { withBase } from "../../utils/paths";
---

<footer class="footer">

  <div class="container footer-grid">

    <div>

      <h3>Nexo Bíblico</h3>

      <p>
        Recursos cristianos para ayudarte a crecer en la fe cada día.
      </p>

      <div class="footer-social">
        <h4>Síguenos en redes</h4>
        <a href="https://www.tiktok.com/@nexo.bblico" target="_blank" rel="noopener noreferrer" aria-label="Sigue a Nexo Bíblico en TikTok">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M19.6 7.1a5.5 5.5 0 0 1-3.4-1.2v8.3a6.2 6.2 0 1 1-5.3-6.1v3.2a3 3 0 1 0 2.1 2.9V2h3.2a5.5 5.5 0 0 0 3.4 4.9v.2Z" />
          </svg>
          <span>TikTok</span>
        </a>
      </div>

    </div>

    <div>

      <h4>Explorar</h4>

      <a href={withBase("/sermones")}>Sermones</a>
      <a href={withBase("/devocionales")}>Devocionales</a>
      <a href={withBase("/versiculos")}>Versículos</a>
      <a href={withBase("/personajes-biblicos")}>Personajes</a>

    </div>

    <div>

      <h4>Recursos</h4>

      <a href={withBase("/estudios-biblicos")}>Estudios</a>
      <a href={withBase("/preguntas-biblicas")}>Preguntas</a>
      <a href={withBase("/diccionario-biblico")}>Diccionario</a>
      <a href={withBase("/oraciones")}>Oraciones</a>

    </div>

    <div>

      <h4>Legal</h4>

      <a href={withBase("/contacto")}>Contacto</a>
      <a href={withBase("/equipo")}>Equipo editorial</a>
      <a href={withBase("/aviso-legal")}>Aviso legal</a>
      <a href={withBase("/privacidad")}>Privacidad</a>
      <a href={withBase("/cookies")}>Cookies</a>

    </div>

  </div>

</footer>
