---
import { getCollection, render } from "astro:content";
import "../../styles/components/sermon-page.css";
import ArticlePage from "../../components/article/ArticlePage.astro";

export async function getStaticPaths() {
  const estudios = (await getCollection("estudiosBiblicos")).filter((entry) => !entry.data.draft);

  return estudios.map((estudio) => ({
    params: {
      slug: estudio.id,
    },
    props: {
      estudio,
    },
  }));
}

const { estudio } = Astro.props;

const estudios = (await getCollection("estudiosBiblicos")).filter((entry) => !entry.data.draft);

const relacionados = estudios
  .filter((e) => e.id !== estudio.id)
  .filter((e) => e.data.category === estudio.data.category)
  .slice(0, 3);

const { Content, headings } = await render(estudio);
---

<ArticlePage
  article={estudio}
  Content={Content}
  headings={headings}
  related={relacionados}
  backUrl="/estudios-biblicos"
  backText="Volver a todos los estudios bíblicos"
  relatedTitle="Estudios relacionados"
/>
