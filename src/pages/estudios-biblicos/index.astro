---
import { getEstudiosBiblicos } from "../../utils/content";
import ClusterIndex from "../../components/article/ClusterIndex.astro";
const entries = await getEstudiosBiblicos();
---
<ClusterIndex
  entries={entries}
  baseUrl="/estudios-biblicos"
  title="Estudios bíblicos para profundizar"
  subtitle="Guías claras y organizadas para comprender el contexto, interpretar mejor las Escrituras y llevar sus enseñanzas a la práctica."
  seoTitle="Estudios bíblicos gratuitos y prácticos"
  seoDescription="Descubre estudios bíblicos gratuitos para comprender la Palabra de Dios, su contexto y su aplicación a la vida diaria."
  eyebrow="Comprende la Biblia paso a paso"
  libraryTitle="Profundiza en las Escrituras"
  countLabel="estudios bíblicos"
  topics={["Contexto", "Interpretación", "Evangelios", "Doctrina", "Personajes", "Aplicación"]}
/>
