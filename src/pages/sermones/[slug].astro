---
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const sermones = await getCollection("sermones");

  return sermones.map((sermon) => ({
    params: {
      slug: sermon.id,
    },
    props: {
      sermon,
    },
  }));
}
const { sermon } = Astro.props;
const { Content } = await render(sermon);
---

<h1>{sermon.data.title}</h1>

<p>{sermon.data.description}</p>

<hr />

<Content />
