---
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const sermones = await getCollection("sermones");

  return sermones.map((sermon) => ({
    params: {
      slug: sermon.id,
    },
    props: {
      sermon,
    },
  }));
}
const { sermon } = Astro.props;
const { Content } = await render(sermon);

import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout
  seo={{
    title: sermon.data.title,
    description: sermon.data.description,
  }}
>
  <section class="container">

    <h1>{sermon.data.title}</h1>

    <p class="sermon-date">
    {sermon.data.pubDate.toLocaleDateString("es-ES", {
    day: "numeric",
    month: "long",
    year: "numeric",
       })}
    </p>

<img
  src={sermon.data.image}
  alt={sermon.data.title}
  class="sermon-image"
/>

    <p>{sermon.data.description}</p>

    <hr />

    <Content />
  </section>
</MainLayout>
