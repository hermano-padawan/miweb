---
import { getCollection, render } from "astro:content";

import MainLayout from "../../layouts/MainLayout.astro";

import CardGrid from "../../components/CardGrid.astro";
import ArticleCard from "../../components/ArticleCard.astro";

import "../../styles/components/sermon-page.css";

export async function getStaticPaths() {
  const sermones = (await getCollection("sermones")).filter((entry) => !entry.data.draft);

  return sermones.map((sermon) => ({
    params: {
      slug: sermon.id,
    },
    props: {
      sermon,
    },
  }));
}

const { sermon } = Astro.props;

const sermones = (await getCollection("sermones")).filter((entry) => !entry.data.draft);

const relacionados = sermones
  .filter((s) => s.id !== sermon.id)
  .filter((s) => s.data.category === sermon.data.category)
  .slice(0, 3);

const { Content, headings } = await render(sermon);

import ArticlePage from "../../components/article/ArticlePage.astro";
---

<ArticlePage
  article={sermon}
  Content={Content}
  headings={headings}
  related={relacionados}
  backUrl="/sermones"
  backText="Volver a todos los sermones"
  relatedTitle="Sermones relacionados"
/>
