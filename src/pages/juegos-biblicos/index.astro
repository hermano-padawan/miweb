---
import MainLayout from "../../layouts/MainLayout.astro";
import { gameCards } from "../../data/games";
import { withBase } from "../../utils/paths";
---
<MainLayout seo={{ title: "Juegos bíblicos online", description: "Elige un juego bíblico y juega en dificultad fácil, media o difícil con 15 preguntas por partida." }}>
  <header class="games-heading">
    <p>¿Cuánto sabes de la Biblia?</p>
    <h1>¿A qué juego quieres jugar?</h1>
    <span>Elige un juego y, cuando esté disponible, selecciona la dificultad. Todas las partidas tienen 15 preguntas.</span>
  </header>
  <main class="games-selector" data-games-selector>
    {gameCards.map((game, index) => (
      <section class="game-option">
        <button type="button" class="game-option__toggle" aria-expanded="false" aria-controls={`game-levels-${index}`} data-game-toggle>
          <span><small>Juego {String(index + 1).padStart(2, "0")}</small><strong>{game.shortTitle}</strong></span>
          <i aria-hidden="true">+</i>
        </button>
        <div class="game-option__levels" id={`game-levels-${index}`} data-game-levels hidden>
          <p>{game.description}</p>
          <div>
            {"supportsLevels" in game && game.supportsLevels === false ? (
              <a class="game-option__play" href={withBase(`/juegos-biblicos/${game.slug}`)}><span>Jugar</span><small>Experiencia única</small></a>
            ) : (
              <>
                <a href={withBase(`/juegos-biblicos/${game.slug}?nivel=facil`)}><span>Fácil</span><small>2 opciones</small></a>
                <a href={withBase(`/juegos-biblicos/${game.slug}?nivel=medio`)}><span>Medio</span><small>3 opciones</small></a>
                <a href={withBase(`/juegos-biblicos/${game.slug}?nivel=dificil`)}><span>Difícil</span><small>15 s por pregunta</small></a>
              </>
            )}
          </div>
        </div>
      </section>
    ))}
  </main>
</MainLayout>
<script>
  const selector = document.querySelector("[data-games-selector]");
  selector?.querySelectorAll<HTMLButtonElement>("[data-game-toggle]").forEach((button) => {
    button.addEventListener("click", () => {
      const panel = document.getElementById(button.getAttribute("aria-controls") || "");
      const open = button.getAttribute("aria-expanded") === "true";
      selector.querySelectorAll<HTMLButtonElement>("[data-game-toggle]").forEach((item) => item.setAttribute("aria-expanded", "false"));
      selector.querySelectorAll<HTMLElement>("[data-game-levels]").forEach((item) => item.hidden = true);
      if (!open && panel) { button.setAttribute("aria-expanded", "true"); panel.hidden = false; }
    });
  });
</script>
<style>
  .games-heading{padding:clamp(3rem,7vw,5.5rem) 1rem;text-align:center;color:#fff;background:#102a43}.games-heading p{margin:0;color:#f0bd62;font-size:.82rem;font-weight:850;letter-spacing:.12em;text-transform:uppercase}.games-heading h1{margin:.45rem 0;font-size:clamp(2.2rem,7vw,4.4rem);line-height:1.05}.games-heading span{display:block;max-width:650px;margin:auto;color:#dbe7ef}.games-selector{width:min(calc(100% - 2rem),820px);margin:3rem auto 5rem}.game-option{border-bottom:1px solid var(--color-border)}.game-option__toggle{display:flex;align-items:center;justify-content:space-between;width:100%;padding:1.25rem .25rem;color:var(--color-text);text-align:left;background:none;border:0;font:inherit;cursor:pointer}.game-option__toggle span{display:grid;gap:.15rem}.game-option__toggle small{color:var(--color-primary-dark);font-size:clamp(.9rem,2vw,1.05rem);font-weight:850;letter-spacing:.08em;text-transform:uppercase}.game-option__toggle strong{font-size:clamp(1.2rem,4vw,1.55rem)}.game-option__toggle i{display:grid;width:36px;height:36px;place-items:center;border:1px solid #bdcad3;border-radius:50%;font-size:1.5rem;font-style:normal;transition:transform .2s}.game-option__toggle[aria-expanded="true"] i{transform:rotate(45deg)}.game-option__levels{padding:0 .25rem 1.35rem}.game-option__levels[hidden]{display:none}.game-option__levels>p{margin:0 0 .9rem;color:var(--color-text-light)}.game-option__levels>div{display:grid;grid-template-columns:repeat(3,1fr);gap:.6rem}.game-option__levels a{display:flex;align-items:center;justify-content:space-between;min-height:54px;padding:.7rem .8rem;background:var(--color-surface);border:1px solid var(--color-border);border-radius:8px}.game-option__levels a:hover{border-color:var(--color-primary)}.game-option__levels a span{font-weight:850}.game-option__levels a small{color:var(--color-text-light)}.game-option__levels .game-option__play{grid-column:1/-1}@media(max-width:560px){.games-selector{width:calc(100% - 1.25rem);margin-top:1.5rem}.game-option__levels>div{grid-template-columns:1fr}.game-option__levels a{min-height:58px}}
</style>
