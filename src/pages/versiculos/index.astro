---
import { getVersiculos } from "../../utils/content";
import ClusterIndex from "../../components/article/ClusterIndex.astro";
const entries = await getVersiculos();
---
<ClusterIndex
  entries={entries}
  baseUrl="/versiculos"
  title="Versículos bíblicos para cada momento"
  subtitle="Pasajes explicados y organizados por temas para meditar en la Palabra de Dios y encontrar dirección, consuelo y esperanza."
  seoTitle="Versículos bíblicos explicados por temas"
  seoDescription="Encuentra versículos bíblicos explicados y organizados por temas para fortalecer tu fe y meditar en la Palabra de Dios."
  eyebrow="La Palabra para tu camino"
  libraryTitle="Encuentra un pasaje para hoy"
  countLabel="recursos bíblicos"
  topics={["Fe", "Amor", "Esperanza", "Fortaleza", "Ansiedad", "Promesas"]}
/>
