---
import { getCollection, render } from "astro:content";

import ArticlePage from "../../components/article/ArticlePage.astro";

export async function getStaticPaths() {
  const diccionario = (await getCollection("diccionarioBiblico")).filter((entry) => !entry.data.draft);

  return diccionario.map((termino) => ({
    params: {
      slug: termino.id,
    },
    props: {
      termino,
    },
  }));
}

const { termino } = Astro.props;

const diccionario = (await getCollection("diccionarioBiblico")).filter((entry) => !entry.data.draft);

const relacionados = diccionario
  .filter((item) => item.id !== termino.id)
  .filter((item) => item.data.category === termino.data.category)
  .slice(0, 3);

const { Content, headings } = await render(termino);
---

<ArticlePage
  article={termino}
  Content={Content}
  headings={headings}
  related={relacionados}
  backUrl="/diccionario-biblico"
  backText="Volver a todas las entradas del diccionario"
  relatedTitle="Términos relacionados"
/>
