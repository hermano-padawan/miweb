---
import { getDiccionarioBiblico } from "../../utils/content";
import ClusterIndex from "../../components/article/ClusterIndex.astro";
const entries = await getDiccionarioBiblico();
---
<ClusterIndex
  entries={entries}
  baseUrl="/diccionario-biblico"
  title="Diccionario bíblico: palabras y significados"
  subtitle="Definiciones sencillas de términos, lugares, costumbres y conceptos para comprender mejor el lenguaje y el contexto de la Biblia."
  seoTitle="Diccionario bíblico de términos y significados"
  seoDescription="Consulta el significado de palabras, lugares, costumbres y conceptos importantes de la Biblia en un diccionario claro y accesible."
  eyebrow="Comprende cada palabra"
  libraryTitle="Explora términos de la Biblia"
  countLabel="definiciones"
  topics={["Conceptos", "Lugares", "Costumbres", "Nombres", "Doctrina", "Símbolos"]}
/>
