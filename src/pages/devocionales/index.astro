---
import { getDevocionales } from "../../utils/content";
import MainLayout from "../../layouts/MainLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import CardGrid from "../../components/CardGrid.astro";

import Section from "../../components/ui/Section.astro";
import SectionTitle from "../../components/ui/SectionTitle.astro";

const devocionales = await getDevocionales();
---

<MainLayout
  seo={{
    title: "Devocionales cristianos | Nexo Bíblico",
    description:
      "Descubre devocionales cristianos basados en la Biblia para fortalecer tu fe y caminar cada día con Dios.",
  }}
>
  <Section>

    <SectionTitle
      title="Devocionales cristianos"
      subtitle="Reflexiones bíblicas para fortalecer tu relación con Dios y crecer espiritualmente cada día."
    />

    <p>
      Encuentra devocionales cristianos sobre la fe, la esperanza, el amor de Dios, la oración, el perdón y muchos otros temas para acompañarte en tu caminar diario con Cristo.
    </p>

    <p>
      <strong>{devocionales.length}</strong> devocionales disponibles.
    </p>

    <CardGrid>
      {
        devocionales.map((devocional) => (
          <ArticleCard
            title={devocional.data.title}
            description={devocional.data.description}
            image={devocional.data.image}
            pubDate={devocional.data.pubDate}
            url={`/devocionales/${devocional.id.replace(".md", "")}`}
          />
        ))
      }
    </CardGrid>

    <!-- Paginación -->
   
    </Section>

  </MainLayout>