---
import { getDevocionales } from "../../utils/content";
import ClusterIndex from "../../components/article/ClusterIndex.astro";
const entries = await getDevocionales();
---
<ClusterIndex
  entries={entries}
  baseUrl="/devocionales"
  title="Devocionales cristianos para cada día"
  subtitle="Reflexiones bíblicas breves para acercarte a Dios, fortalecer tu fe y aplicar su Palabra a las situaciones cotidianas."
  seoTitle="Devocionales cristianos para cada día"
  seoDescription="Lee devocionales cristianos basados en la Biblia para comenzar el día con Dios y crecer espiritualmente."
  eyebrow="Un momento diario con Dios"
  libraryTitle="Reflexiones para alimentar tu fe"
  countLabel="devocionales"
  topics={["Fe", "Oración", "Esperanza", "Gratitud", "Propósito", "Paz"]}
/>
