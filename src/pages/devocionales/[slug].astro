---
import { getCollection, render } from "astro:content";

import MainLayout from "../../layouts/MainLayout.astro";

import CardGrid from "../../components/CardGrid.astro";
import ArticleCard from "../../components/ArticleCard.astro";

import "../../styles/components/article-page.css";

export async function getStaticPaths() {
  const devocionales = await getCollection("devocionales");

  return devocionales.map((devocional) => ({
    params: {
      slug: devocional.id,
    },
    props: {
      devocional,
    },
  }));
}

const { devocional } = Astro.props;

const devocionales = await getCollection("devocionales");

const relacionados = devocionales
  .filter((s) => s.id !== devocional.id)
  .filter((s) => s.data.category === devocional.data.category)
  .slice(0, 3);

const { Content } = await render(devocional);

import ArticlePage from "../../components/article/ArticlePage.astro";
---

<ArticlePage
  article={devocional}
  Content={Content}
  related={relacionados}
  backUrl="/sermones"
  backText="Volver a todos los sermones"
  relatedTitle="Sermones relacionados"
/>