---
import { getPreguntasBiblicas } from "../../utils/content";
import ClusterIndex from "../../components/article/ClusterIndex.astro";
const entries = await getPreguntasBiblicas();
---
<ClusterIndex
  entries={entries}
  baseUrl="/preguntas-biblicas"
  title="Preguntas bíblicas con respuestas claras"
  subtitle="Respuestas accesibles y fundamentadas en las Escrituras para comprender mejor a Dios, la fe cristiana y la vida espiritual."
  seoTitle="Preguntas bíblicas y respuestas claras"
  seoDescription="Encuentra respuestas bíblicas claras sobre Dios, Jesús, la salvación, la oración y las preguntas más frecuentes de la fe cristiana."
  eyebrow="Entiende lo que crees"
  libraryTitle="Resuelve tus dudas sobre la fe"
  countLabel="respuestas bíblicas"
  topics={["Dios", "Jesús", "Salvación", "Biblia", "Oración", "Vida eterna"]}
/>
