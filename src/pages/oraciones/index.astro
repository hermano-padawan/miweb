---
import { getOraciones } from "../../utils/content";
import ClusterIndex from "../../components/article/ClusterIndex.astro";
const entries = await getOraciones();
---
<ClusterIndex
  entries={entries}
  baseUrl="/oraciones"
  title="Oraciones cristianas para cada necesidad"
  subtitle="Oraciones inspiradas en la Biblia para agradecer, pedir dirección, encontrar paz y presentar cada necesidad delante de Dios."
  seoTitle="Oraciones cristianas para cada momento"
  seoDescription="Encuentra oraciones cristianas para pedir fortaleza, paz y dirección, dar gracias a Dios y acompañar cada momento de tu vida."
  eyebrow="Acércate a Dios con confianza"
  libraryTitle="Encuentra palabras para orar"
  countLabel="oraciones"
  topics={["Gratitud", "Ansiedad", "Familia", "Salud", "Dirección", "Fortaleza"]}
/>
