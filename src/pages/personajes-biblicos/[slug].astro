---
import { getCollection, render } from "astro:content";

import "../../styles/components/sermon-page.css";

import ArticlePage from "../../components/article/ArticlePage.astro";

export async function getStaticPaths() {

  const personajes = await getCollection("personajesBiblicos");

  return personajes.map((personaje) => ({
    params: {
      slug: personaje.id,
    },
    props: {
      personaje,
    },
  }));

}

const { personaje } = Astro.props;

const personajes = await getCollection("personajesBiblicos");

const relacionados = personajes
  .filter((p) => p.id !== personaje.id)
  .filter((p) => p.data.category === personaje.data.category)
  .slice(0, 3);

const { Content, headings } = await render(personaje);
---

<ArticlePage
  article={personaje}
  Content={Content}
  headings={headings}
  related={relacionados}
  backUrl="/personajes-biblicos"
  backText="Volver a todos los personajes bíblicos"
  relatedTitle="Personajes relacionados"
/>
