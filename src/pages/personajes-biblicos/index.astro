---
import { getPersonajesBiblicos } from "../../utils/content";
import ClusterIndex from "../../components/article/ClusterIndex.astro";
const entries = await getPersonajesBiblicos();
---
<ClusterIndex
  entries={entries}
  baseUrl="/personajes-biblicos"
  title="Personajes bíblicos: historias y lecciones"
  subtitle="Conoce a los hombres y mujeres de la Biblia, su contexto, sus decisiones y las enseñanzas que su vida deja para nosotros."
  seoTitle="Personajes bíblicos: historias y significado"
  seoDescription="Conoce la historia y las enseñanzas de los principales personajes bíblicos, desde Abraham y Moisés hasta Jesús y Pablo."
  eyebrow="Vidas que enseñan y transforman"
  libraryTitle="Descubre sus historias"
  countLabel="biografías bíblicas"
  topics={["Patriarcas", "Reyes", "Profetas", "Mujeres", "Discípulos", "Apóstoles"]}
/>
