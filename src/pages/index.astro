---
import MainLayout from "../layouts/MainLayout.astro";
import Hero from "../components/Hero.astro";

import FeaturedArticle from "../components/home/FeaturedArticle.astro";
import LatestArticles from "../components/home/LatestArticles.astro";
import CategoryGrid from "../components/home/CategoryGrid.astro";
import TagCloud from "../components/home/TagCloud.astro";

import {
  getSermones,
  getDevocionales,
  getCategories,
  getTags,
} from "../utils/content";

const sermones = await getSermones();
const devocionales = await getDevocionales();

const categorias = await getCategories();
const tags = await getTags();

const destacado = sermones[0];
---

<MainLayout
  seo={{
    title: "Portal Cristiano",
    description: "Sermones, devocionales y recursos para crecer en la fe.",
  }}
>

  <Hero />

  <div class="container">

    <FeaturedArticle
      article={destacado}
    />

    <LatestArticles
      title="Últimos sermones"
      articles={sermones}
      baseUrl="/sermones"
      buttonText="Ver todos los sermones"
    />

    <LatestArticles
      title="Últimos devocionales"
      articles={devocionales}
      baseUrl="/devocionales"
      buttonText="Ver todos los devocionales"
    />

    <CategoryGrid
      categories={categorias}
    />

    <TagCloud
      tags={tags}
    />

  </div>

</MainLayout>