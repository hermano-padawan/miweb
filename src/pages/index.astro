---
import MainLayout from "../layouts/MainLayout.astro";
import { getCollection } from "astro:content";
import SermonCard from "../components/SermonCard.astro";
import ContentSection from "../components/ContentSection.astro";
import Hero from "../components/Hero.astro";
import "../styles/components/cards-grid.css";
import Button from "../components/ui/Button.astro";

const sermones = (await getCollection("sermones")).sort(
  (a, b) =>
    b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
---

<MainLayout
  seo={{
    title: "Portal Cristiano",
    description: "Sermones, reflexiones y estudios bíblicos."
  }}
>

<Hero />

<ContentSection
  title="Últimos sermones"
  description="Los tres sermones más recientes publicados."
>
  <div class="cards-grid">
  {sermones.slice(0, 3).map((sermon) => (
    <SermonCard
  title={sermon.data.title}
  description={sermon.data.description}
  image={sermon.data.image}
  pubDate={sermon.data.pubDate}
  url={`/sermones/${sermon.id.replace(".md", "")}`}
/>
  ))}
</div>

<div class="section-actions">
  <Button href="/sermones">
    Ver todos los sermones
  </Button>
</div>

</ContentSection>

  

</MainLayout>