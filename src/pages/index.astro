---
import MainLayout from "../layouts/MainLayout.astro";
import { getCollection } from "astro:content";
import SermonCard from "../components/SermonCard.astro";
const sermones = await getCollection("sermones");
import ContentSection from "../components/ContentSection.astro";
import Hero from "../components/Hero.astro";
---

<MainLayout
  seo={{
    title: "Portal Cristiano",
    description: "Sermones, reflexiones y estudios bíblicos."
  }}
>

<Hero />

<ContentSection
  title="Sermones"
  description="Reflexiones, estudios y mensajes para fortalecer tu fe cada día."
>

  <div class="cards-grid">
  {sermones.map((sermon) => (
    <SermonCard
      title={sermon.data.title}
      description={sermon.data.description}
      url={`/sermones/${sermon.id.replace(".md", "")}`}
    />
  ))}
</div>

</ContentSection>

  

</MainLayout>