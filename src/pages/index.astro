---
import MainLayout from "../layouts/MainLayout.astro";
import { getCollection } from "astro:content";
import SermonCard from "../components/SermonCard.astro";
const sermones = await getCollection("sermones");
---

<MainLayout
  seo={{
    title: "Portal Cristiano",
    description: "Sermones, reflexiones y estudios bíblicos."
  }}
>

  <section>
  <h1>Sermones</h1>
  <p>
    Reflexiones, estudios y mensajes para fortalecer tu fe cada día.
  </p>

  <div>
    {sermones.map((sermon) => (
      <SermonCard
        title={sermon.data.title}
        description={sermon.data.description}
        url={`/sermones/${sermon.id.replace(".md", "")}`}
      />
    ))}
  </div>
</section>

  

</MainLayout>